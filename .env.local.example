NEXT_PUBLIC_API_URL=http://localhost:8000

# -------------------------------------------------------------------
# Firebase Client SDK (ALL are public — safe to expose in the browser)
# Obtain from: Firebase Console → Project Settings → General → Your apps
# -------------------------------------------------------------------
