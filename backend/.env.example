# "development" (default) or "production". In production the app REFUSES to
# start unless DATABASE_URL is PostgreSQL and API_KEY_ENCRYPTION_KEY is set.
ENVIRONMENT=development

# Production (Supabase PostgreSQL via Railway)
# Use the TRANSACTION POOLER connection string (port 6543). The direct host
# db.<ref>.supabase.co is IPv6-only and unreachable from most IPv4 hosts.
# Supabase > Settings > Database > Connection string > Transaction pooler.
# Rotation: update the credential in the DB provider, set the new value here,
# and restart. Keep old credentials valid until the app is restarted.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Secret used to encrypt user API keys at rest (Fernet). Generate with:
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# MUST be set in production. Rotation: replace the value and restart; previously
# stored ciphertext will no longer decrypt, so users must re-save their keys.
API_KEY_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Rate-limiter client identity. Default (false): X-Forwarded-For is trusted
# ONLY when the socket peer is a private/internal address (i.e. behind a proxy
# such as Railway's ingress), so a client reaching a public port directly cannot
# spoof its identity. Set to true ONLY to trust X-Forwarded-For unconditionally
# (when the proxy does not present a private peer address).
# TRUST_PROXY_HEADERS=false

# AI provider (server-side). Development-only key; never commit a real key.
# Rotation: replace the value and restart the process (the key is read from
# configuration at startup). New chats use the new key immediately.
# GROQ_API_KEY=your-groq-api-key
# AI_MODEL=llama-3.3-70b-versatile
# AI_MAX_TOKENS=1024

# Optional production overrides
# DATABASE_SSLMODE=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# Optional app overrides
# Browser origins allowed to call this API. Supply CORS_ORIGINS as a normal
# string: a single origin, or comma-separated origins. JSON lists still work
# but are not required. Whitespace, trailing "/" and duplicates are stripped
# automatically. In production the value must contain NO localhost entries
# (config refuses to start with them). Examples:
# CORS_ORIGINS=https://your-app.vercel.app
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# RETENTION_DAYS=4
# CLEANUP_INTERVAL_HOURS=1

# -------------------------------------------------------------------
# Firebase Admin SDK (SERVER-SIDE ONLY — NEVER expose to the browser)
# Obtain from: Firebase Console → Project Settings → Service accounts
# → Generate new private key → download JSON file
# Option A: specify path to the downloaded JSON file
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
#
# Option B: set individual values from the JSON file
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# -------------------------------------------------------------------

# Secret key for signing OTP email verification tokens (JWT HS256)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# OTP_SECRET_KEY=change-me-to-a-long-random-string

# -------------------------------------------------------------------
# SMTP (real email delivery for OTP verification codes)
# Used by POST /auth/otp/send. Port 465 uses implicit TLS; any other port uses
# STARTTLS. Leave unset in development to disable delivery (the API then
# returns a safe error). Credentials are never logged or exposed to the client.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_FROM_NAME=AI Chatbot
# -------------------------------------------------------------------
